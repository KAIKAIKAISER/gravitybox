{
  "name": "gravitybox",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "GravityBox: Antigravity Companion for Windows & macOS · Antigravity 全功能增强伴侣（支持 Windows Electron 桌面端与系统托盘）",
  "license": "MIT",
  "author": "Enzoo404 <enzoo404@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enzoo404/gravitybox.git"
  },
  "bugs": {
    "url": "https://github.com/Enzoo404/gravitybox/issues"
  },
  "homepage": "https://github.com/Enzoo404/gravitybox#readme",
  "scripts": {
    "build": "node tools/clean-dist.mjs && tsc && node tools/copy-runtime.mjs",
    "test": "npm run build && node tools/sync-pricing-feed.mjs && node tools/run-tests.mjs",
    "test:unit": "npm run build && node tools/run-tests.mjs",
    "test:fast": "npm run build && node tools/run-tests.mjs --fast",
    "test:native": "npm run build && node tools/run-tests.mjs --native",
    "test:native-ui": "npm run build && node --test test/native-ui.mjs",
    "test:browser": "npm run build && node test/browser.mjs",
    "check:swift": "node tools/native-build.mjs --typecheck",
    "check:privacy": "node tools/check-privacy.mjs",
    "start": "node dist/main.js",
    "electron:start": "npm run build && electron .",
    "verify": "node tools/verify.mjs",
    "verify:strict": "node tools/verify.mjs --strict",
    "package:win": "npm run build && node tools/generate-win-ico.mjs && node tools/package-win.mjs",
    "package:mac": "npm run verify && node tools/package-mac.mjs",
    "package:mac:full": "npm run verify && node tools/package-mac.mjs && node tools/update-acceptance.mjs && node tools/check-docs.mjs",
    "i18n:extract": "node tools/extract-ui-strings.mjs",
    "i18n:coverage": "node tools/coverage-report.mjs",
    "i18n:gate": "npm run build && node tools/coverage-report.mjs --gate",
    "i18n:merge": "node tools/merge-translations.mjs",
    "i18n:pipeline": "npm run i18n:extract && npm run i18n:coverage",
    "i18n:pending": "node tools/coverage-report.mjs --pending-out reports/pending.json",
    "i18n:scan": "npm run build && node tools/scan-ui.mjs --resources-only",
    "bench:usage": "npm run build && node tools/benchmark-usage.mjs",
    "icons:gen": "node tools/generate-icons.mjs",
    "doctor": "node tools/doctor.mjs",
    "setup:dev": "node tools/doctor.mjs --setup",
    "prestart": "npm run build",
    "prebuild": "node tools/doctor.mjs --install",
    "preverify": "node tools/doctor.mjs --install"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "build": {
    "appId": "local.gravitybox.app",
    "productName": "GravityBox",
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "dict/**",
      "assets/**",
      "package.json"
    ],
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dict/**/*",
      "assets/**/*",
      "!assets/screenshots/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "成品"
    },
    "win": {
      "icon": "assets/icons/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "GravityBox-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "GravityBox-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "^36.9.5",
    "electron-builder": "^26.18.0",
    "typescript": "5.9.3"
  }
}
